# ============================================================
# CropAI - Production Environment Variables Template
# Copy this to .env for local development or configure in Vercel Project Settings
# ============================================================

# Environment Mode
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------
# 1. Hosted MySQL Database (Cloud Provider: TiDB, Aiven, or Railway)
# Option A: Full Connection URI (Recommended for Cloud MySQL)
# ------------------------------------------------------------
DATABASE_URL=mysql://user:password@gateway.region.tidbcloud.com:4000/crop_recommendation_db?ssl={"rejectUnauthorized":false}

# Option B: Individual Database Parameters
DB_HOST=gateway.region.tidbcloud.com
DB_PORT=4000
DB_NAME=crop_recommendation_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=true
DB_CONNECTION_LIMIT=5

# ------------------------------------------------------------
# 2. JWT Authentication Secrets
# ------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# 3. Microservices & External APIs
# ------------------------------------------------------------
# Optional: External Python FastAPI ML URL (leave as default or your cloud deployment)
ML_SERVICE_URL=http://localhost:8000

# OpenWeatherMap API Key (Get free key at https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ------------------------------------------------------------
# 4. Frontend & CORS
# ------------------------------------------------------------
FRONTEND_URL=*
